{
  "$schema": "../node_modules/@tauri-apps/cli/schema/acl/capability.schema.json",
  "identifier": "default",
  "description": "Default capability",
  "windows": ["main", "output"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state",
    "fs:allow-read",
    "fs:allow-write",
    "sql:default"
  ]
}
